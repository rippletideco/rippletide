{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Rippletide Documentation",
  "theme": "mint",
  "topbarCtaButton": {
    "name": "Get Started",
    "url": "/docs"
  },
  "logo": {
    "light": "/img/rippletide_logo_navy_text_bg.svg",
    "dark": "/img/logo-rippletide 2_contrastlight.svg"
  },
  "favicon": "/img/favicon.ico",
  "colors": {
    "primary": "#fca5bf",
    "light": "#fca5bf",
    "dark": "#000"
  },
  "anchors": [
    {
      "name": "Discord",
      "icon": "discord",
      "url": "https://discord.gg/zUPTRH5eFv"
    }
  ],
  "primaryTab": {
    "name": "Documentation"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Welcome",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Agent Evaluation",
            "expanded": false,
            "pages": [
              "docs/evaluation_overview",
              "docs/cli_guide"
            ]
          },
          {
            "group": "Context Graph",
            "expanded": true,
            "pages": [
              "docs/mcp/overview",
              "docs/mcp/quickstart",
              "docs/mcp/configuration",
              "docs/mcp/tools",
              "docs/mcp/try-it-yourself",
              {
                "group": "Coding Agents (Use case)",
                "expanded": false,
                "pages": [
                  "docs/coding-agents/overview",
                  "docs/coding-agents/connect",
                  "docs/coding-agents/coding-session",
                  "docs/coding-agents/rule-management",
                  "docs/coding-agents/rule-sharing",
                  "docs/coding-agents/planning",
                  "docs/coding-agents/team-governance"
                ]
              }
            ]
          },
          {
            "group": "Decision Runtime",
            "expanded": true,
            "pages": [
              "docs/hypergraph_overview",
              {
                "group": "Rippletide Platform",
                "expanded": false,
                "pages": [
                  "docs/trust-platform/overview"
                ]
              },
              {
                "group": "Integrations",
                "expanded": false,
                "pages": [
                  "docs/trust-platform/integrations/amazon-bedrock",
                  "docs/trust-platform/integrations/mcp"
                ]
              }
            ]
          },
          {
            "group": "Community",
            "pages": [
              "docs/community"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Evaluation API",
            "pages": [
              {
                "group": "Health",
                "expanded": true,
                "pages": [
                  "api-reference/eval/health/health-check"
                ]
              },
              {
                "group": "Agents",
                "expanded": true,
                "pages": [
                  "api-reference/eval/agents/list-agents",
                  "api-reference/eval/agents/create-agent",
                  "api-reference/eval/agents/get-agent-by-id",
                  "api-reference/eval/agents/update-agent",
                  "api-reference/eval/agents/delete-agent"
                ]
              },
              {
                "group": "Knowledge",
                "expanded": true,
                "pages": [
                  "api-reference/eval/knowledge/list-knowledge-items",
                  "api-reference/eval/knowledge/add-knowledge-item",
                  "api-reference/eval/knowledge/delete-knowledge-item"
                ]
              },
              {
                "group": "Evaluation Questions",
                "expanded": true,
                "pages": [
                  "api-reference/eval/test-prompts/get-test-prompts",
                  "api-reference/eval/test-prompts/create-test-prompt",
                  "api-reference/eval/test-prompts/update-test-prompt",
                  "api-reference/eval/test-prompts/delete-test-prompt"
                ]
              },
              {
                "group": "Evaluation Results",
                "expanded": true,
                "pages": [
                  "api-reference/eval/test-results/run-test-for-prompt",
                  "api-reference/eval/test-results/get-test-results",
                  "api-reference/eval/test-results/clear-test-results"
                ]
              },
              {
                "group": "Source Import",
                "expanded": true,
                "pages": [
                  "api-reference/eval/knowledge-import/import-source-url",
                  "api-reference/eval/knowledge-import/upload-pdf"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "css": [
    "/css/custom.css"
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/zUPTRH5eFv" ,
      "github": "https://github.com/rippletideco/starter",
      "linkedin": "https://linkedin.com/company/rippletide"
    }
  }
}
