{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Rippletide Documentation",
  "description": "Install rippletide-package, connect an agent repository, inspect runtime evidence, and enforce rules before important actions execute.",
  "theme": "mint",
  "colors": {
    "primary": "#E996AE",
    "light": "#E996AE",
    "dark": "#262656"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index", "docs/quickstart"]
      },
      {
        "group": "Connect",
        "pages": [
          "docs/connect-agent",
          "docs/connect-mcp-server",
          "docs/manual-setup",
          "docs/api-keys"
        ]
      },
      {
        "group": "Rules",
        "pages": ["docs/write-rules", "docs/observe-and-enforce"]
      },
      {
        "group": "Observe",
        "pages": ["docs/harness-management", "docs/runtime-events"]
      },
      {
        "group": "Improve",
        "pages": ["docs/evaluate-improve"]
      },
      {
        "group": "Reference",
        "pages": ["docs/cli"]
      }
    ]
  },
  "redirects": [
    { "source": "/docs/introduction", "destination": "/" },
    { "source": "/docs/cli_guide", "destination": "/docs/cli" },
    { "source": "/docs/mcp/overview", "destination": "/docs/connect-mcp-server" },
    { "source": "/docs/mcp/quickstart", "destination": "/docs/connect-mcp-server" },
    { "source": "/docs/mcp/configuration", "destination": "/docs/manual-setup" },
    { "source": "/docs/mcp/tools", "destination": "/docs/harness-management" },
    { "source": "/docs/mcp/try-it-yourself", "destination": "/docs/quickstart" },
    { "source": "/docs/hypergraph_overview", "destination": "/" },
    { "source": "/docs/trust-platform/overview", "destination": "/" },
    { "source": "/docs/trust-platform/integrations/mcp", "destination": "/docs/connect-mcp-server" },
    { "source": "/docs/trust-platform/integrations/amazon-bedrock", "destination": "/docs/manual-setup" },
    { "source": "/docs/coding-agents/overview", "destination": "/docs/connect-agent" },
    { "source": "/docs/coding-agents/connect", "destination": "/docs/connect-agent" },
    { "source": "/docs/coding-agents/coding-session", "destination": "/docs/runtime-events" },
    { "source": "/docs/coding-agents/rule-management", "destination": "/docs/write-rules" },
    { "source": "/docs/coding-agents/rule-sharing", "destination": "/docs/write-rules" },
    { "source": "/docs/coding-agents/planning", "destination": "/docs/evaluate-improve" },
    { "source": "/docs/coding-agents/team-governance", "destination": "/docs/write-rules" },
    { "source": "/docs/community", "destination": "/" },
    { "source": "/api-reference/introduction", "destination": "/docs/manual-setup" }
  ],
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/rippletideco/rippletide",
      "linkedin": "https://linkedin.com/company/rippletide"
    }
  }
}
