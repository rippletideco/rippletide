{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Rippletide Documentation",
  "description": "Connect existing agents, inspect runtime evidence, and apply reviewed business rules at action and response boundaries.",
  "theme": "mint",
  "colors": {
    "primary": "#E996AE",
    "light": "#E996AE",
    "dark": "#262656"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "docs/quickstart",
          "docs/fleet",
          "docs/workspaces"
        ]
      },
      {
        "group": "Connect",
        "pages": [
          "docs/connect-agent",
          "docs/connect-python",
          "docs/connect-mcp-server",
          "docs/connect-codex",
          "docs/manual-setup",
          "docs/manual-python-setup"
        ]
      },
      {
        "group": "Rules and sources",
        "pages": [
          "docs/write-rules",
          "docs/business-context",
          "docs/evaluate-improve",
          "docs/observe-and-enforce",
          "docs/result-filtering"
        ]
      },
      {
        "group": "Inspect evidence",
        "pages": [
          "docs/harness-management",
          "docs/runtime-events"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "docs/cli",
          "docs/policy-api",
          "docs/api-keys",
          "docs/privacy"
        ]
      }
    ]
  },
